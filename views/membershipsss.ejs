<%-include("header.ejs")-%>
<h2 style="text-align: center; background-color: #08d9d6;">MARIAN STUDENTS ONLINE MEMBERSHIP REGISTRATION </h2>
<form class="" action="/membershipsss" method="post">
  <div class="form-row">
    <div class="form-group col-md-5">
      <label for="name">Name</label>
      <input type="text" class="form-control" name="fname" value="" placeholder="Enter name" required>
    </div>
  <div class="form-group col-md-5">
    <label for="phone">Phone Number</label>
    <input type="number" class="form-control" name="phone" placeholder="Enter mobile number" required>
  </div>
  <div class="form-group col-md-5">
    <label for="email">Mail ID</label>
    <input type="email" class="form-control" name="mail" placeholder="E-Mail ID" required>
  </div>
  <div class="form-group col-md-5">
    <label for="number">Branch</label>
    <select  name="branch" class="form-control" required>
       <option value="" disabled selected>Branch</option>
       <option value="Mechanical">Mechanical</option>
       <option value="Electronics and Communication">Electronics and Communication</option>
       <option value="Electrical and Electronics">Electrical and Electronics</option>
       <option value="Computer Science">Computer Science</option>
       <option value="Civil">Civil</option>

  </select>
  </div>
  <div class="form-group col-md-5">
    <label for="number">Current Semester</label>
    <select  name="semester" class="form-control" required>
       <option value="" disabled selected>Current Semester</option>
       <option value="1">S1</option>
       <option value="2">S2</option>
       <option value="3">S3</option>
       <option value="4">S4</option>
       <option value="5">S5</option>
       <option value="6">S6</option>
       <option value="7">S7</option>
       <option value="8">S8</option>
  </select>
  </div>
  <div class="form-group col-md-5">
    <label for="number">Admission Number</label>
    <input type="text" class="form-control" name="admissionNumber" placeholder="Admission Number" required>
  </div>
  <div class="form-group col-md-5">
    <label for="number">University roll no</label>
    <input type="text" class="form-control" name="rollnumber" placeholder="University roll no" required>
  </div>
  <div class="form-group col-md-5">
    <label for="address">Address</label>
    <textarea  type="text" class="form-control" name="address" placeholder="Address" required></textarea>
  </div>


  <div class="form-group col-md-5">
    <label for="exper">Programming Knowledge</label>
    <input type="text" class="form-control" name="programmingKnowledge" placeholder="Programming Knowledge" required>
  </div>
  <div class="form-group col-md-5">
    <label for="exper">Expectations about Club</label>
  <textarea type="text" class="form-control" name="expectationClub" placeholder="Expectations about Club" required></textarea>
  </div>
  <div class="form-group col-md-5">
</div>
  <div class="form-group col-md-5">
      <button class="btn btn-dark" type="submit" name="button">SUBMIT</button>
  </div>

  </div>


</form>
<%-include("footer.ejs")-%>
